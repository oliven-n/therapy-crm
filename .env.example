# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
#
# All three come from the Supabase dashboard:
#   Project Settings > API Keys

# Your project's REST endpoint. Safe to expose - NEXT_PUBLIC_ vars are compiled
# into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable/anon key. Also safe in the browser: it carries no privileges
# of its own, and every request it makes is still subject to RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The secret/service_role key. BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never import this into a client component, never prefix it
# with NEXT_PUBLIC_, never paste it into a chat or an issue. If it leaks, rotate
# it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=
